CONFIG = Path(os.environ.get("HIL_BENCH_CONFIG", "~/.config/hil-bench/benches.toml")).expanduser()
STATE = Path(os.environ.get("XDG_STATE_HOME", "~/.local/state")).expanduser() / "hil-bench"

# Board-agnostic defaults: anything Linux prints whatever boots it.
# Bootloader stages (EEPROM, U-Boot, UEFI) and image checks (FIT signatures)
# belong in the bench config's [boot] stages / fail_patterns.
DEFAULT_STAGES = [
    {"name": "kernel", "pattern": r"Booting Linux", "optional": True},
    {"name": "login", "pattern": r"^(?!Last )\S+ login: "},
]
DEFAULT_FAIL = [r"Kernel panic"]


class BenchError(Exception):
    """Bench, config or infrastructure problem (exit 2)."""


class BenchLocked(Exception):
    """Another run holds the bench (exit 3)."""


# --------------------------------------------------------------------- config

def load_config() -> dict:
    if not CONFIG.exists():
        raise BenchError(f"no bench config at {CONFIG} (copy examples/benches.toml.example)")
    with CONFIG.open("rb") as f:
        return tomllib.load(f)


def get_bench(cfg: dict, name: str | None) -> tuple[str, dict]:
    benches = cfg.get("benches", {})
    name = name or os.environ.get("HIL_BENCH") or cfg.get("default_bench")
    if not name:
        raise BenchError("no bench selected (-b, HIL_BENCH, or default_bench)")
    if name not in benches:
        raise BenchError(f"unknown bench '{name}' (have: {', '.join(benches) or 'none'})")
    return name, benches[name]


@contextlib.contextmanager
def bench_lock(name: str, what: str):
    """Exclusive per-bench lock so two projects never cycle the same board."""
    STATE.mkdir(parents=True, exist_ok=True)
    path = STATE / f"{name}.lock"
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            holder = os.pread(fd, 256, 0).decode(errors="replace").partition("\n")[0].strip()
            raise BenchLocked(f"bench '{name}' is busy: {holder or 'unknown holder'}")
        os.ftruncate(fd, 0)
        os.pwrite(fd, f"pid {os.getpid()} ({what}) since {now_iso()}\n".encode(), 0)
        yield
    finally:
        os.close(fd)


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


# ---------------------------------------------------------------------- power

class Tasmota:
    def __init__(self, conf: dict):
        self.host = conf["host"]
        self.relay = int(conf.get("relay", 1))
        self.user, self.password = self._creds(conf)

    @staticmethod
    def _creds(conf: dict) -> tuple[str, str]:
        env = {}
        creds = conf.get("creds_file")
        if creds:
            p = Path(creds).expanduser()
            if not p.exists():
                raise BenchError(f"creds_file {p} not found")
            for line in p.read_text().splitlines():
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    env[k.removeprefix("export ").strip()] = v.strip().strip("'\"")
        user = os.environ.get("TASMOTA_USER", env.get("TASMOTA_USER", ""))
        password = os.environ.get("TASMOTA_PASS", env.get("TASMOTA_PASS", ""))
        return user, password

    def cmd(self, command: str) -> dict:
        # Credentials go through urllib, never argv, so they stay out of ps/logs.
        q = {"cmnd": command}
        if self.user:
            q |= {"user": self.user, "password": self.password}
        url = f"http://{self.host}/cm?{urllib.parse.urlencode(q)}"
        try:
            with urllib.request.urlopen(url, timeout=5) as r:
                body = json.loads(r.read())
        except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError) as e:
            raise BenchError(f"tasmota {self.host} unreachable: {getattr(e, 'reason', e)}") from None
        except json.JSONDecodeError:
            raise BenchError(f"tasmota {self.host}: non-JSON reply (bad credentials?)") from None
        if "WARNING" in body:
            raise BenchError(f"tasmota {self.host}: {body['WARNING']}")
        return body

    def _state(self, body: dict) -> str:
        for key in (f"POWER{self.relay}", "POWER"):
            if key in body:
                return body[key]
        raise BenchError(f"tasmota: no relay state in reply {body}")

    def power(self, action: str | None = None) -> str:
        return self._state(self.cmd(f"Power{self.relay}" + (f" {action}" if action else "")))

    def energy(self) -> dict:
        e = self.cmd("Status 8").get("StatusSNS", {}).get("ENERGY", {})
        return {"watts": e.get("Power"), "volts": e.get("Voltage"), "amps": e.get("Current"),
                "kwh_today": e.get("Today")}

    def status(self) -> dict:
        return {"relay": self.power()} | self.energy()


def make_power(bench: dict):
    conf = bench.get("power") or {}
    kind = conf.get("type")
    if kind == "tasmota":
        return Tasmota(conf)
    raise BenchError(f"unsupported power type: {kind!r}")


def power_cycle(psu, off_seconds: float, while_off=None) -> float:
    """Off, wait, on. Returns the monotonic time the relay closed.
    while_off runs with the relay open (e.g. to drop the old run's UART bytes)."""
    try:
        # Inside the try: if the relay opened but the reply was lost, the
        # finally still closes it again.
        psu.power("Off")
        time.sleep(off_seconds)
        if while_off:
            while_off()
    finally:
        # Never leave the board dark because the host run was interrupted.
        state = psu.power("On")
    if state != "ON":
        raise BenchError(f"relay did not close (state {state})")
    return time.monotonic()


# The plug's meter refreshes about once a second and is only as good as its
# calibration (see docs/nous-a8t.md); treat watts as indicative, not lab data.

def power_summary(samples: list[dict]) -> dict:
    """avg/min/max watts and trapezoid-integrated Wh over [{"t", "watts"}, ...]."""
    pts = [(s["t"], s["watts"]) for s in samples if s.get("watts") is not None]
    if not pts:
        return {"samples": 0}
    w = [p[1] for p in pts]
    joules = sum((t2 - t1) * (w1 + w2) / 2 for (t1, w1), (t2, w2) in zip(pts, pts[1:]))
    span = pts[-1][0] - pts[0][0]
    # Time-weighted, so it agrees with wh even when the sample spacing drifts.
    avg = joules / span if span > 0 else statistics.fmean(w)
    return {"samples": len(pts), "avg_w": round(avg, 2), "min_w": min(w),
            "max_w": max(w), "wh": round(joules / 3600, 4), "span_s": round(span, 2)}


def check_interval(x: float | None, flag: str) -> None:
    if x is not None and not (math.isfinite(x) and x > 0):
        raise BenchError(f"{flag} must be a positive number of seconds")


class PowerSampler:
    """Polls the plug's meter in a thread, timed from t0 (relay close)."""

    def __init__(self, psu, interval: float, t0: float):
        self.psu, self.interval, self.t0 = psu, interval, t0
        self.samples: list[dict] = []
        self.error: str | None = None
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._run, daemon=True)

    def _run(self) -> None:
        while not self._stop.is_set():
            tick = time.monotonic()
            try:
                e = self.psu.energy()
            except Exception as err:  # a dropped reading must not fail the boot
                self.error = f"{type(err).__name__}: {err}"
            else:
                self.samples.append({"t": round(time.monotonic() - self.t0, 2), "watts": e["watts"]})
            self._stop.wait(max(0.0, self.interval - (time.monotonic() - tick)))

    def __enter__(self):
        self._thread.start()
        return self

    def __exit__(self, *exc):
        self._stop.set()
        self._thread.join(timeout=10)
        if self._thread.is_alive():
            self.error = "sampler still blocked on the plug after 10 s"

    def summary(self) -> dict:
        s = power_summary(self.samples) | {"interval_s": self.interval}
        return s | ({"error": self.error} if self.error else {})


# --------------------------------------------------------------------- serial

def serial_path(bench: dict) -> str:
    port = (bench.get("serial") or {}).get("port")
    if not port:
        raise BenchError("bench has no serial.port")
    return port


def port_holders(port: str) -> list[str]:
    """Processes with the tty open (tio, the MCP serial server, ...)."""
    real = os.path.realpath(port)
    holders = []
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            for fd in os.listdir(f"/proc/{pid}/fd"):
                if os.path.realpath(f"/proc/{pid}/fd/{fd}") == real:
                    comm = Path(f"/proc/{pid}/comm").read_text().strip()
                    holders.append(f"{comm}[{pid}]")
                    break
        except (PermissionError, FileNotFoundError, ProcessLookupError):
            continue
    return holders


def open_serial(bench: dict):
    try:
        import serial  # pyserial
    except ImportError:
        raise BenchError("pyserial not installed (python3 -m pip install --user pyserial)") from None
    port = serial_path(bench)
    if not os.path.exists(port):
        raise BenchError(f"serial port {port} not present")
    holders = port_holders(port)
    if holders:
        raise BenchError(f"{port} already open by {', '.join(holders)}; close it first "
                         "(serial_close for the MCP server, quit tio)")
    baud = int(bench["serial"].get("baud", 115200))
    try:
        return serial.Serial(port, baud, timeout=0.2, exclusive=True)
    except serial.SerialException as e:
        raise BenchError(f"cannot open {port}: {e}") from None


def log_paths(log_dir: str | None, name: str, kind: str) -> tuple[Path, Path]:
    d = Path(log_dir).expanduser() if log_dir else STATE / "logs"
    d.mkdir(parents=True, exist_ok=True)
    stem = f"{name}-{kind}-{dt.datetime.now():%Y%m%d-%H%M%S}"
    return d / f"{stem}.log", d / f"{stem}.json"


# ------------------------------------------------------------------- commands

def cmd_power(args, name, bench) -> int:
    psu = make_power(bench)
    if args.action == "status":
        print(json.dumps(psu.status()))
        return 0
    if args.action == "watch":
        return power_watch(args, psu)
    with bench_lock(name, f"power {args.action}"):
        if args.action == "cycle":
            off = args.off_seconds or float(bench["power"].get("off_seconds", 5))
            power_cycle(psu, off)
            print(json.dumps({"relay": "ON", "cycled_off_seconds": off}))
        else:
            print(json.dumps({"relay": psu.power(args.action.capitalize())}))
    return 0


def power_watch(args, psu) -> int:
    """Sample W/V/A until --duration or Ctrl-C, then summarize. Read-only: no lock."""
    check_interval(args.interval, "--interval")
    check_interval(args.duration, "--duration")
    try:
        csv = Path(args.csv).expanduser().open("w") if args.csv else None
    except OSError as e:
        raise BenchError(f"cannot write --csv: {e}") from None
    if csv:
        csv.write("t_s,watts,volts,amps\n")
    samples, errors, t0 = [], 0, time.monotonic()
    try:
        while args.duration is None or time.monotonic() - t0 <= args.duration:
            tick = time.monotonic()
            try:
                s = {"t": round(tick - t0, 2)} | psu.energy()
            except BenchError as e:  # keep sampling; one dropped reading isn't fatal
                errors += 1
                print(f"hil: {e}", file=sys.stderr)
            else:
                samples.append(s)
                line = ",".join("" if v is None else str(v)
                                for v in (s["t"], s["watts"], s["volts"], s["amps"]))
                print(line, flush=True)
                if csv:
                    csv.write(line + "\n")
                    csv.flush()
            time.sleep(max(0.0, args.interval - (time.monotonic() - tick)))
    except KeyboardInterrupt:
        pass
    finally:
        if csv:
            csv.close()
    print(json.dumps(power_summary(samples) | ({"errors": errors} if errors else {})))
    return 0


class Console:
    """UART reader that logs raw bytes and keeps a decoded, searchable buffer.

    The buffer is capped, so offsets that outlive a pump() are absolute:
    `base` counts the characters trimmed off its front. mark() returns the
    current end as an absolute offset, local() turns one back into an index
    into `buf` (0 if that text was already trimmed)."""

    def __init__(self, ser, log, t0: float):
        self.ser, self.log, self.t0 = ser, log, t0
        self.buf = ""
        self.base = 0

    def mark(self) -> int:
        return self.base + len(self.buf)

    def local(self, pos: int) -> int:
        return min(max(0, pos - self.base), len(self.buf))

    def drop_before(self, pos: int) -> None:
        """Forget everything before absolute offset pos."""
        cut = self.local(pos)
        self.buf, self.base = self.buf[cut:], self.base + cut

    def elapsed(self) -> float:
        return round(time.monotonic() - self.t0, 2)

    def pump(self) -> str:
        chunk = self.ser.read(4096)
        if not chunk:
            return ""
        self.log.write(chunk)
        self.log.flush()
        text = chunk.decode("latin-1").replace("\r", "")
        self.buf += text
        if len(self.buf) > 1 << 20:  # bounded on chatty consoles
            self.drop_before(self.mark() - (1 << 16))
        return text

    def write(self, data: str) -> None:
        # Paced: the U-Boot UART has a small RX FIFO and no flow control.
        raw = data.encode()
        for i in range(0, len(raw), 8):
            self.ser.write(raw[i:i + 8])
            self.ser.flush()
            time.sleep(0.01)

    def expect(self, rx: re.Pattern, timeout: float, start: int | None = None):
        """Wait for rx in the buffer from absolute offset `start` (default: now).
        Returns the match (indices into the current `buf`) or None."""
        pos = self.mark() if start is None else start
        deadline = time.monotonic() + timeout
        while True:
            m = rx.search(self.buf, self.local(pos))
            if m:
                return m
            if time.monotonic() >= deadline:
                return None
            self.pump()


def stage_config(bench: dict, timeout: float | None):
    boot = bench.get("boot") or {}
    stages = boot.get("stages") or DEFAULT_STAGES
    compiled = [(s["name"], re.compile(s["pattern"], re.M), bool(s.get("optional"))) for s in stages]
    fails = [re.compile(p) for p in boot.get("fail_patterns", DEFAULT_FAIL)]
    return compiled, fails, timeout or float(boot.get("timeout", 180))


def watch_stages(con: Console, compiled, fails, timeout: float, result: dict) -> bool:
    """Match stages in order on the console (including what is already
    buffered). Optional stages may be silent; required ones decide PASS."""
    pos = idx = scanned = 0  # absolute offsets (see Console)
    while idx < len(compiled) and time.monotonic() - con.t0 < timeout:
        # Fail patterns: scan only new text (with overlap for split lines).
        fail = next((m for f in fails if (m := f.search(con.buf, con.local(scanned - 200)))), None)
        scanned = con.mark()
        if fail:
            result["fail_match"] = fail.group(0)
            break
        progressed = False
        for j in range(idx, len(compiled)):
            sname, rx, optional = compiled[j]
            m = rx.search(con.buf, con.local(pos))
            if m:
                result["missed"] += [compiled[k][0] for k in range(idx, j)]
                result["stages"][sname] = con.elapsed()
                pos, idx, progressed = con.base + m.end(), j + 1, True
                break
            if not optional:
                break
        if not progressed:
            con.pump()
    result["missed"] += [c[0] for c in compiled[idx:]]
    required = {c[0] for c in compiled if not c[2]}
    return result["fail_match"] is None and required <= result["stages"].keys()


def stages_already_seen(compiled, text: str) -> list[str]:
    """Names of the stages that `text` already shows, walked in order the way
    watch_stages does: an optional stage may be absent, a missing required
    one ends the run. Used for the part of a boot printed before an
    autoboot interrupt, which won't repeat after `boot`."""
    seen, pos = [], 0
    for sname, rx, optional in compiled:
        m = rx.search(text, pos)
        if m:
            seen.append(sname)
            pos = m.end()
        elif not optional:
            break
    return seen


def print_stages(result: dict) -> None:
    if result.get("before_interrupt"):
        print(f"     ---   {', '.join(result['before_interrupt'])} (before the autoboot interrupt)")
    prev = 0.0
    for sname, t in result["stages"].items():
        print(f"  {t:7.2f}s  (+{t - prev:6.2f}s)  {sname}")
        prev = t
    for sname in result["missed"]:
        print(f"     ---   {sname} (not seen)")
    if result.get("power"):
        p = result["power"]
        if p.get("samples"):
            print(f"  power: avg {p['avg_w']} W, peak {p['max_w']} W, {p['wh']} Wh over {p['span_s']}s "
                  f"({p['samples']} samples)")
        if p.get("error"):
            print(f"  power: sampling error: {p['error']}")
    if result.get("fail_match"):
        print(f"  FAIL pattern: {result['fail_match']!r}")


def start_console(args, name, bench, ser, log) -> Console:
    if args.no_cycle:
        ser.reset_input_buffer()
        return Console(ser, log, time.monotonic())
    off = float(bench["power"].get("off_seconds", 5))
    # Clear while the relay is open, so the previous run's tail can't leak in.
    return Console(ser, log, power_cycle(make_power(bench), off, ser.reset_input_buffer))


def boot_once(args, name, bench, ser, compiled, fails, timeout, kind: str) -> dict:
    log_path, json_path = log_paths(args.log_dir, name, kind)
    result = {"bench": name, "started": now_iso(), "log": str(log_path),
              "cycled": not args.no_cycle, "stages": {}, "missed": [], "fail_match": None}
    with log_path.open("wb") as log:
        con = start_console(args, name, bench, ser, log)
        if args.power_interval:
            with PowerSampler(make_power(bench), args.power_interval, con.t0) as ps:
                ok = watch_stages(con, compiled, fails, timeout, result)
            result["power"] = ps.summary()
        else:
            ok = watch_stages(con, compiled, fails, timeout, result)
        result["elapsed"] = con.elapsed()
    result["result"] = "PASS" if ok else "FAIL"
    json_path.write_text(json.dumps(result, indent=2) + "\n")
    return result


def series_stats(runs: list[dict]) -> dict:
    """Per-stage min/median/max/stdev over the runs that reached each stage."""
    stats = {}
    for sname in dict.fromkeys(s for r in runs for s in r["stages"]):
        ts = [r["stages"][sname] for r in runs if sname in r["stages"]]
        stats[sname] = {"n": len(ts), "min": min(ts), "median": round(statistics.median(ts), 2),
                        "max": max(ts), "stdev": round(statistics.stdev(ts), 2) if len(ts) > 1 else 0.0}
    whs = [r["power"]["wh"] for r in runs if r.get("power", {}).get("samples")]
    if whs:
        stats["energy_wh"] = {"n": len(whs), "min": min(whs), "median": round(statistics.median(whs), 4),
                              "max": max(whs)}
    return stats


def cmd_boot(args, name, bench) -> int:
    if args.repeat < 1:
        raise BenchError("--repeat must be >= 1")
    if args.repeat > 1 and args.no_cycle:
        raise BenchError("--repeat needs power cycles; drop --no-cycle")
    check_interval(args.power_interval, "--power-interval")
    if args.settle < 0 or not math.isfinite(args.settle):
        raise BenchError("--settle must be >= 0 seconds")
    compiled, fails, timeout = stage_config(bench, args.timeout)

    runs, aborted, interrupted = [], None, False
    with bench_lock(name, "boot" if args.repeat == 1 else f"boot x{args.repeat}"), \
            open_serial(bench) as ser:
        try:
            for i in range(args.repeat):
                kind = "boot" if args.repeat == 1 else f"boot-r{i + 1:02d}"
                r = boot_once(args, name, bench, ser, compiled, fails, timeout, kind)
                runs.append(r)
                if not args.json:
                    if args.repeat > 1:
                        print(f"run {i + 1}/{args.repeat}")
                    print_stages(r)
                    print(f"{r['result']}  {name}  ({r['elapsed']}s)  log: {r['log']}")
                if i + 1 < args.repeat:
                    # Leave the board up, e.g. so an A/B scheme can mark the
                    # slot good before the next power cut.
                    time.sleep(args.settle)
        except (BenchError, KeyboardInterrupt) as e:
            if args.repeat == 1:
                raise
            aborted, interrupted = f"{type(e).__name__}: {e}", isinstance(e, KeyboardInterrupt)

    if args.repeat == 1:
        if args.json:
            print(json.dumps(runs[0]))
        return 0 if runs[0]["result"] == "PASS" else 1

    passed = sum(r["result"] == "PASS" for r in runs)
    series = {"bench": name, "runs": len(runs), "requested": args.repeat, "passed": passed,
              "settle_s": args.settle, "stats": series_stats(runs), "logs": [r["log"] for r in runs]}
    if aborted:
        series["aborted"] = aborted
    _, json_path = log_paths(args.log_dir, name, "boot-series")
    json_path.write_text(json.dumps(series, indent=2) + "\n")
    if aborted:
        print(f"hil: series aborted after {len(runs)}/{args.repeat} runs: {aborted}", file=sys.stderr)
        print(f"partial summary: {json_path}", file=sys.stderr)
        return 130 if interrupted else 2
    if args.json:
        print(json.dumps(series))
    else:
        print(f"\n{'stage':16} {'n':>3} {'min':>8} {'median':>8} {'max':>8} {'stdev':>7}")
        for sname, s in series["stats"].items():
            print(f"{sname:16} {s['n']:3} {s['min']:8} {s['median']:8} {s['max']:8} {s.get('stdev', ''):>7}")
        print(f"{passed}/{len(runs)} PASS  {name}  summary: {json_path}")
    return 0 if passed == len(runs) else 1


# ------------------------------------------------------------- U-Boot rescue

# Prompt text names its own stop string on keyed autoboot ("type 'abc' to
# stop", "Type 'abc' within 3 seconds"); plain autoboot says "Hit any key".
AUTOBOOT_RX = re.compile(r"[Tt]ype '([^']+)'[^\n]*(?:stop|autoboot)|Hit any key to stop autoboot")
# Seen before any autoboot prompt => autoboot is not interruptible (e.g. a
# BOOTDELAY=-2 production lockdown) and the window has passed.
# Extend per bench with [uboot] too_late_patterns (e.g. a bootcmd's own log tag).
TOO_LATE_DEFAULT = [r"## Loading kernel", r"Starting kernel", r"Booting Linux"]
UBOOT_PROMPT = r"(?:U-Boot> |=> )"
# Commands that can destroy a card or the whole env; need --allow-destructive.
DESTRUCTIVE_RX = re.compile(
    r"\b(?:mmc\s+(?:write|erase|swrite|part|partconf|bootbus|rst)|erase|env\s+default|gpt\s+write"
    r"|fatwrite|ext4write|fatrm|sf\s+(?:erase|write|update)|ums|dfu|fastboot|nand\s+(?:erase|write))\b")
# RAUC's U-Boot boot-selection convention; only used when [uboot] ab = "rauc".
RAUC_VARS = ["BOOT_ORDER", "BOOT_A_LEFT", "BOOT_B_LEFT"]


class UbootError(Exception):
    """The target did not reach / cooperate at the U-Boot shell (exit 1)."""


def uboot_interrupt(con: Console, bench: dict, stop: str | None, timeout: float) -> dict:
    """Catch the autoboot countdown and stop it. Returns what was seen."""
    conf = bench.get("uboot") or {}
    too_late = re.compile("|".join(TOO_LATE_DEFAULT + conf.get("too_late_patterns", [])))
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        m = AUTOBOOT_RX.search(con.buf)
        if m:
            key = stop or conf.get("stop_string") or m.group(1) or " "
            after = con.base + m.end()
            con.write(key)
            if not con.expect(re.compile(UBOOT_PROMPT + r"$"), 5, start=after):
                # Some builds want a newline after a keyed string.
                con.write("\r")
                if not con.expect(re.compile(UBOOT_PROMPT + r"$"), 3, start=after):
                    raise UbootError(f"sent stop string {key!r} but got no U-Boot prompt")
            return {"autoboot_prompt": m.group(0), "stop_string": key, "at": con.elapsed()}
        if too_late.search(con.buf):
            raise UbootError("autoboot was not interruptible (no countdown before kernel load; "
                             "production BOOTDELAY=-2 lockdown?)")
        con.pump()
    raise UbootError(f"no autoboot prompt within {timeout:.0f}s")


def uboot_cmd(con: Console, cmd: str, timeout: float = 10) -> dict:
    """Type a command, verify the echo, then execute it and capture output."""
    if "\n" in cmd or "\r" in cmd:
        raise BenchError("one U-Boot command per line")
    for _attempt in (1, 2):
        mark = con.mark()
        con.write(cmd)
        echo_rx = re.compile(re.escape(cmd) + r"$")
        if con.expect(echo_rx, 3, start=mark):
            break
        con.write("\x03")  # Ctrl-C: discard the garbled line, get a fresh prompt
        con.expect(re.compile(UBOOT_PROMPT + r"$"), 3, start=mark)
    else:
        raise UbootError(f"echo mismatch twice for {cmd!r}; not executed")
    mark = con.mark()
    con.write("\r")
    m = con.expect(re.compile(UBOOT_PROMPT + r"$"), timeout, start=mark)
    if not m:
        raise UbootError(f"no prompt after {cmd!r} within {timeout:.0f}s")
    out = con.buf[con.local(mark):m.start()].strip("\n")
    return {"cmd": cmd, "output": out}


def uboot_rc(con: Console, cmd: str, timeout: float = 10) -> dict:
    """Run cmd and capture its exit status via hush's $? (None if unsupported)."""
    r = uboot_cmd(con, cmd, timeout)
    rc = uboot_cmd(con, "echo HILRC=$?")["output"]
    m = re.search(r"HILRC=(\d+)", rc)
    r["rc"] = int(m.group(1)) if m else None
    return r


def env_vars(bench: dict) -> list[str]:
    conf = bench.get("uboot") or {}
    extra = conf.get("env_vars", [])
    if not (isinstance(extra, list) and all(isinstance(v, str) for v in extra)):
        raise BenchError("[uboot] env_vars must be a list of variable names")
    return (RAUC_VARS if conf.get("ab") == "rauc" else []) + extra


def read_env(con: Console, names: list[str]) -> dict:
    env = {}
    for var in names:
        out = uboot_cmd(con, f"printenv {var}")["output"]
        m = re.search(rf"^{var}=(.*)$", out, re.M)
        env[var] = m.group(1).strip() if m else None
    return env


def cmd_uboot(args, name, bench) -> int:
    ab = (bench.get("uboot") or {}).get("ab")
    if args.action in ("slot", "reset-counters") and ab != "rauc":
        raise BenchError(f"'{args.action}' needs an A/B scheme: set [benches.{name}.uboot] ab = \"rauc\"")
    if args.action == "slot" and args.slot not in ("A", "B"):
        raise BenchError("slot must be A or B")
    if args.action == "run":
        if not args.commands:
            raise BenchError("run needs at least one command")
        bad = [c for c in args.commands if DESTRUCTIVE_RX.search(c)]
        if bad and not args.allow_destructive:
            raise BenchError(f"refusing destructive command(s) {bad} without --allow-destructive")
    then = "console" if args.action == "shell" else args.then
    attempts = str(args.attempts)

    log_path, json_path = log_paths(args.log_dir, name, "uboot")
    result = {"bench": name, "started": now_iso(), "log": str(log_path), "action": args.action,
              "cycled": not args.no_cycle, "commands": [], "then": then,
              "stages": {}, "missed": [], "fail_match": None}
    ok = False
    try:
        with bench_lock(name, f"uboot {args.action}"), open_serial(bench) as ser, \
                log_path.open("wb") as log:
            con = start_console(args, name, bench, ser, log)
            result["interrupt"] = uboot_interrupt(con, bench, args.stop_string, args.prompt_timeout)
            names = env_vars(bench)
            result["env_before"] = read_env(con, names)

            if args.action == "slot":
                other = "B" if args.slot == "A" else "A"
                steps = [f"setenv BOOT_ORDER {args.slot} {other}",
                         f"setenv BOOT_A_LEFT {attempts}", f"setenv BOOT_B_LEFT {attempts}", "saveenv"]
            elif args.action == "reset-counters":
                steps = [f"setenv BOOT_A_LEFT {attempts}", f"setenv BOOT_B_LEFT {attempts}", "saveenv"]
            elif args.action == "run":
                steps = args.commands
            elif args.action == "env" and not names:
                steps = ["printenv"]  # nothing configured to pick out: dump it all
            else:  # env, shell
                steps = []
            for c in steps:
                r = uboot_rc(con, c, timeout=args.cmd_timeout)
                result["commands"].append(r)
                if r["rc"] not in (0, None):
                    raise UbootError(f"{c!r} failed (rc={r['rc']}): {r['output'][-200:]}")
            if args.action in ("slot", "reset-counters"):
                result["env_after"] = read_env(con, names)

            if then == "boot":
                compiled, fails, timeout = stage_config(bench, args.timeout)
                # Stages already passed before the interrupt (eeprom, U-Boot
                # banner) won't repeat, required or not; judge only the rest.
                seen = stages_already_seen(compiled, con.buf)
                result["before_interrupt"] = seen
                compiled = [c for c in compiled if c[0] not in seen]
                mark = con.mark()
                con.write("boot\r")
                con.drop_before(mark)  # judge only the boot we just started
                ok = watch_stages(con, compiled, fails, con.elapsed() + timeout, result)
            elif then == "reset":
                con.write("reset\r")
                ok = True
            else:  # stay / console: leave the board at the U-Boot prompt
                ok = True
            result["elapsed"] = con.elapsed()
    except UbootError as e:
        result["error"] = str(e)
        if "interrupt" in result:
            result["error"] += " -- board left at the U-Boot prompt (hil power cycle to recover)"

    result["result"] = "PASS" if ok else "FAIL"
    json_path.write_text(json.dumps(result, indent=2) + "\n")
    if args.json:
        print(json.dumps(result))
    else:
        if "interrupt" in result:
            i = result["interrupt"]
            print(f"  {i['at']:7.2f}s  stopped autoboot with {i['stop_string']!r}")
        for key in ("env_before", "env_after"):
            if result.get(key):
                env = " ".join(f"{k}={v}" for k, v in result[key].items() if v is not None)
                print(f"  {key}: {env or '(none of the configured vars set)'}")
        for r in result["commands"]:
            print(f"  $ {r['cmd']}  [rc={r['rc']}]")
            for line in r["output"].splitlines():
                print(f"      {line}")
        if then == "boot":
            print_stages(result)
        if "error" in result:
            print(f"  ERROR: {result['error']}")
        print(f"{result['result']}  {name}  uboot {args.action} (then {then})  log: {log_path}")

    if ok and then == "console":
        return cmd_console(args, name, bench)
    return 0 if ok else 1


def cmd_wait_ssh(args, name, bench) -> int:
    ssh = bench.get("ssh") or {}
    host = args.host or os.environ.get("HIL_TARGET") or ssh.get("host")
    if not host:
        raise BenchError("no ssh host (--host, HIL_TARGET, or ssh.host)")
    port = int(ssh.get("port", 22))
    deadline = time.monotonic() + (args.timeout or float(ssh.get("timeout", 120)))
    while time.monotonic() < deadline:
        try:
            with socket.create_connection((host, port), timeout=2) as s:
                s.settimeout(3)
                if s.recv(64).startswith(b"SSH-"):
                    print(f"ssh up: {host}:{port}")
                    return 0
        except OSError:
            pass
        time.sleep(2)
    print(f"ssh not reachable: {host}:{port}", file=sys.stderr)
    return 1


def cmd_console(args, name, bench) -> int:
    tio = shutil.which("tio")
    if not tio:
        raise BenchError("tio not installed")
    port = serial_path(bench)
    holders = port_holders(port)
    if holders:
        raise BenchError(f"{port} already open by {', '.join(holders)}")
    log_dir = Path(args.log_dir).expanduser() if args.log_dir else STATE / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    baud = str(bench["serial"].get("baud", 115200))
    os.execv(tio, [tio, "-b", baud, "--log", "--log-directory", str(log_dir), port])


def cmd_benches(args, cfg) -> int:
    default = cfg.get("default_bench")
    for n, b in cfg.get("benches", {}).items():
        mark = "*" if n == default else " "
        print(f"{mark} {n:12} {b.get('description', '')}  [{serial_path(b)}]")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="hil", description=__doc__.split("\n\n")[0])
    ap.add_argument("-b", "--bench", help="bench name (default: HIL_BENCH or default_bench)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("power", help="relay control and energy reading")
    p.add_argument("action", choices=["status", "on", "off", "cycle", "watch"])
    p.add_argument("--off-seconds", type=float)
    p.add_argument("--interval", type=float, default=1.0, help="watch: seconds between samples")
    p.add_argument("--duration", type=float, help="watch: stop after S seconds (default: Ctrl-C)")
    p.add_argument("--csv", help="watch: also write samples to this CSV file")

    p = sub.add_parser("boot", help="(power-cycle and) assert boot stages on the UART")
    p.add_argument("--no-cycle", action="store_true", help="watch a boot you trigger yourself")
    p.add_argument("--repeat", type=int, default=1,
                   help="boot N times and report per-stage min/median/max/stdev")
    p.add_argument("--settle", type=float, default=0.0,
                   help="--repeat: keep the board up S seconds after each run before the next cycle "
                        "(an A/B bench needs long enough to mark the slot good)")
    p.add_argument("--power-interval", type=float,
                   help="sample the plug's meter every S seconds during the boot "
                        "(avg/peak W and Wh until the stage watch ends)")
    p.add_argument("--timeout", type=float)
    p.add_argument("--log-dir")
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("uboot", help="stop autoboot and inspect/repair the U-Boot env")
    p.add_argument("action", choices=["env", "slot", "reset-counters", "run", "shell"])
    p.add_argument("slot", nargs="?", help="A or B (for 'slot')")
    p.add_argument("-c", "--cmd", dest="commands", action="append", default=[],
                   help="U-Boot command for 'run' (repeatable, executed in order)")
    p.add_argument("--then", choices=["boot", "stay", "reset"], default="boot",
                   help="after the action: boot and watch to login (default), stay at the prompt, or reset")
    p.add_argument("--attempts", type=int, default=3,
                   help="BOOT_x_LEFT value for slot/reset-counters (ab = \"rauc\" benches)")
    p.add_argument("--stop-string", help="override the autoboot stop string (auto-detected from the prompt)")
    p.add_argument("--allow-destructive", action="store_true", help="permit erase/write/env-default commands")
    p.add_argument("--no-cycle", action="store_true", help="catch a reset you trigger yourself")
    p.add_argument("--prompt-timeout", type=float, default=60, help="seconds to wait for the autoboot prompt")
    p.add_argument("--cmd-timeout", type=float, default=15)
    p.add_argument("--timeout", type=float, help="boot-to-login timeout when --then boot")
    p.add_argument("--log-dir")
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("wait-ssh", help="wait until the target's sshd answers")
    p.add_argument("--host")
    p.add_argument("--timeout", type=float)

    p = sub.add_parser("console", help="interactive tio session with logging")
    p.add_argument("--log-dir")

    sub.add_parser("benches", help="list configured benches")

    args = ap.parse_args()
    try:
        cfg = load_config()
        if args.cmd == "benches":
            return cmd_benches(args, cfg)
        name, bench = get_bench(cfg, args.bench)
        return {"power": cmd_power, "boot": cmd_boot, "uboot": cmd_uboot, "wait-ssh": cmd_wait_ssh,
                "console": cmd_console}[args.cmd](args, name, bench)
    except BenchLocked as e:
        print(f"hil: {e}", file=sys.stderr)
        return 3
    except BenchError as e:
        print(f"hil: {e}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())

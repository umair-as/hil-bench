CONFIG = Path(os.environ.get("HIL_BENCH_CONFIG", "~/.config/hil-bench/benches.toml")).expanduser()
STATE = Path(os.environ.get("XDG_STATE_HOME", "~/.local/state")).expanduser() / "hil-bench"
# Overridden by the config's [paths] table (apply_paths), e.g. to share one
# state/lock/log location owned by a service user.
LOCK_DIR: Path | None = None    # default: STATE
LOG_DIR: Path | None = None     # default: STATE / "logs"
CREDS_FILE: str | None = None   # default plug creds_file for benches without one
PATH_KEYS = ("state_dir", "lock_dir", "log_dir", "creds_file")

# Board-agnostic defaults: anything Linux prints whatever boots it.
# Bootloader stages (EEPROM, U-Boot, UEFI) and image checks (FIT signatures)
# belong in the bench config's [boot] stages / fail_patterns.
DEFAULT_STAGES = [
    {"name": "kernel", "pattern": r"Booting Linux", "optional": True},
    {"name": "login", "pattern": r"^(?!Last )\S+ login: "},
]
DEFAULT_FAIL = [r"Kernel panic"]


class BenchError(Exception):
    """Bench, config or infrastructure problem (exit 2)."""


class BenchLocked(Exception):
    """Another run holds the bench (exit 3)."""


# --------------------------------------------------------------------- config

def load_config() -> dict:
    if not CONFIG.exists():
        raise BenchError(f"no bench config at {CONFIG} (copy examples/benches.toml.example)")
    with CONFIG.open("rb") as f:
        return tomllib.load(f)


def apply_paths(cfg: dict) -> None:
    """Take state, lock, log and default creds locations from [paths]."""
    global STATE, LOCK_DIR, LOG_DIR, CREDS_FILE
    paths = cfg.get("paths") or {}
    unknown = set(paths) - set(PATH_KEYS)
    if unknown:
        raise BenchError(f"unknown [paths] key(s): {', '.join(sorted(unknown))} (have: {', '.join(PATH_KEYS)})")
    resolved = {}
    for key, val in paths.items():
        p = Path(str(val)).expanduser()
        if not p.is_absolute():
            raise BenchError(f"[paths] {key} must be an absolute path, got {val!r}")
        resolved[key] = p
    if "state_dir" in resolved:
        STATE = resolved["state_dir"]
    if "lock_dir" in resolved:
        LOCK_DIR = resolved["lock_dir"]
    if "log_dir" in resolved:
        LOG_DIR = resolved["log_dir"]
    if "creds_file" in resolved:
        CREDS_FILE = str(resolved["creds_file"])


def default_log_dir() -> Path:
    return LOG_DIR or STATE / "logs"


def get_bench(cfg: dict, name: str | None) -> tuple[str, dict]:
    benches = cfg.get("benches", {})
    name = name or os.environ.get("HIL_BENCH") or cfg.get("default_bench")
    if not name:
        raise BenchError("no bench selected (-b, HIL_BENCH, or default_bench)")
    if name not in benches:
        raise BenchError(f"unknown bench '{name}' (have: {', '.join(benches) or 'none'})")
    return name, benches[name]


def flock_holders(path: Path | str, proc_locks: str | None = None) -> list[int]:
    """PIDs holding an exclusive flock(2) on path, from /proc/locks. Works
    across users (the file is world-readable) and never touches the lock."""
    try:
        st = os.stat(path)
        text = proc_locks if proc_locks is not None else Path("/proc/locks").read_text()
    except OSError:
        return []
    want = (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
    pids = []
    for line in text.splitlines():
        f = line.split()
        # "N: FLOCK  ADVISORY  WRITE <pid> <maj>:<min>:<inode> <start> <end>";
        # blocked waiters have "->" after the index and are skipped.
        if len(f) < 6 or f[1] != "FLOCK" or f[3] != "WRITE":
            continue
        try:
            maj, mnr, ino = f[5].split(":")
            if (int(maj, 16), int(mnr, 16), int(ino)) == want:
                pids.append(int(f[4]))
        except ValueError:
            continue
    return pids


def lock_path(name: str) -> Path:
    return (LOCK_DIR or STATE) / f"{name}.lock"


def inherited_lock(path: Path) -> int | None:
    """The lock fd handed down by `hil hold` (HIL_LOCK_FD), if it really is
    this bench's lock and this process tree holds it. Proof is a successful
    non-blocking flock on that very fd: an fd from a fresh open() of the
    lock file fails it while someone else holds the lock."""
    raw = os.environ.get("HIL_LOCK_FD", "")
    if not raw.isdigit():
        return None
    fd = int(raw)
    try:
        st, want = os.fstat(fd), os.stat(path)
        if (st.st_dev, st.st_ino) != (want.st_dev, want.st_ino):
            return None
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:  # bad fd, no lock file, or held by someone else
        return None
    return fd


CALLERS = ("human", "agent")


def caller_policy(cfg: dict, bench: dict) -> str:
    """'human' or 'agent', from HIL_CALLER, top-level `caller` and the
    bench's `caller`. Any source saying 'agent' wins, an unknown value
    counts as 'agent', and nothing set means 'human'. So the environment
    can only tighten what the config says, never loosen it."""
    sources = [os.environ.get("HIL_CALLER"), cfg.get("caller"), bench.get("caller")]
    given = [v for v in sources if v is not None]
    if any(v not in CALLERS or v == "agent" for v in given):
        return "agent"
    return "human"


@contextlib.contextmanager
def bench_lock(name: str, what: str):
    """Exclusive per-bench lock so two projects never cycle the same board.
    Yields the lock's fd. Inside `hil hold`, the inherited lock is reused:
    nothing is rewritten and nothing is released on exit."""
    path = lock_path(name)
    path.parent.mkdir(parents=True, exist_ok=True)
    nested = inherited_lock(path)
    if nested is not None:
        yield nested
        return
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            holder = os.pread(fd, 256, 0).decode(errors="replace").partition("\n")[0].strip()
            raise BenchLocked(f"bench '{name}' is busy: {holder or 'unknown holder'}")
        os.ftruncate(fd, 0)
        os.pwrite(fd, f"pid {os.getpid()} ({what}) since {now_iso()}\n".encode(), 0)
        yield fd
    finally:
        os.close(fd)


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


# ---------------------------------------------------------------- action log
# Every state-changing command leaves a "start" and an "end" line in
# <state>/actions.jsonl, so a power-off at 3 a.m. can be traced afterwards.

def is_recorded(args) -> bool:
    if args.cmd == "power":
        return args.action in ("on", "off", "cycle")
    return args.cmd in ("boot", "uboot", "console", "hold")


def current_user() -> str:
    try:
        return pwd.getpwuid(os.getuid()).pw_name
    except KeyError:
        return str(os.getuid())


def append_action(record: dict) -> None:
    path = STATE / "actions.jsonl"
    line = (json.dumps(record, separators=(",", ":")) + "\n").encode()
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, line)  # one write per line: O_APPEND keeps lines whole
        finally:
            os.close(fd)
    except OSError as e:
        raise BenchError(f"cannot write the action log {path}: {e}") from None


def run_recorded(name: str, args, fn, argv: list[str]) -> int:
    """Run fn() between a start and an end record. No start record, no action."""
    rec = {"pid": os.getpid(), "user": current_user(), "caller": getattr(args, "caller", None),
           "bench": name, "argv": argv} | ({"via": args.via} if getattr(args, "via", None) else {})
    append_action({"ts": now_iso(), "event": "start"} | rec)
    rc, err = None, None
    try:
        rc = fn()
        return rc
    except BenchLocked as e:
        rc, err = 3, str(e)
        raise
    except BenchError as e:
        rc, err = 2, str(e)
        raise
    except KeyboardInterrupt:
        rc, err = 130, "interrupted"
        raise
    except Exception as e:
        err = f"{type(e).__name__}: {e}"
        raise
    finally:
        end = {"ts": now_iso(), "event": "end"} | rec | {"rc": rc} | ({"error": err} if err else {})
        try:
            append_action(end)
        except BenchError as e:
            print(f"hil: warning: {e}", file=sys.stderr)


# ---------------------------------------------------------------------- power

# The plug's /cm API takes credentials in the query string over plain HTTP.
# Never route that through http_proxy/HTTP_PROXY from the environment.
_DIRECT = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def pulsetime_value(seconds: float) -> int:
    """Tasmota PulseTime encoding: 1..111 = 0.1 s steps, 112..64900 = value-100 s."""
    if not (math.isfinite(seconds) and 0.1 <= seconds <= 64800):
        raise BenchError("max-on time must be 0.1..64800 seconds (Tasmota PulseTime)")
    return max(1, round(seconds * 10)) if seconds <= 11.1 else round(seconds) + 100


class Tasmota:
    def __init__(self, conf: dict):
        self.host = conf["host"]
        self.relay = int(conf.get("relay", 1))
        # Both off by default; see README "Plug-side safety".
        self.plug_cycle = conf.get("cycle_on_plug", False)
        if not isinstance(self.plug_cycle, bool):
            raise BenchError("[power] cycle_on_plug must be true or false")
        self.max_on = conf.get("max_on_seconds")
        if self.max_on is not None:
            if isinstance(self.max_on, bool) or not isinstance(self.max_on, (int, float)):
                raise BenchError("[power] max_on_seconds must be a number of seconds")
            pulsetime_value(self.max_on)
        self.user, self.password = self._creds(conf)

    @staticmethod
    def _creds(conf: dict) -> tuple[str, str]:
        env = {}
        creds = conf.get("creds_file") or CREDS_FILE
        if creds:
            p = Path(creds).expanduser()
            if not p.exists():
                raise BenchError(f"creds_file {p} not found")
            for line in p.read_text().splitlines():
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    env[k.removeprefix("export ").strip()] = v.strip().strip("'\"")
        user = os.environ.get("TASMOTA_USER", env.get("TASMOTA_USER", ""))
        password = os.environ.get("TASMOTA_PASS", env.get("TASMOTA_PASS", ""))
        return user, password

    def cmd(self, command: str) -> dict:
        # Credentials go through urllib, never argv, so they stay out of ps/logs.
        q = {"cmnd": command}
        if self.user:
            q |= {"user": self.user, "password": self.password}
        url = f"http://{self.host}/cm?{urllib.parse.urlencode(q)}"
        try:
            with _DIRECT.open(url, timeout=5) as r:
                body = json.loads(r.read())
        except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError) as e:
            raise BenchError(f"tasmota {self.host} unreachable: {getattr(e, 'reason', e)}") from None
        except json.JSONDecodeError:
            raise BenchError(f"tasmota {self.host}: non-JSON reply (bad credentials?)") from None
        if "WARNING" in body:
            raise BenchError(f"tasmota {self.host}: {body['WARNING']}")
        return body

    def _state(self, body: dict) -> str:
        for key in (f"POWER{self.relay}", "POWER"):
            if key in body:
                return body[key]
        raise BenchError(f"tasmota: no relay state in reply {body}")

    def power(self, action: str | None = None) -> str:
        return self._state(self.cmd(f"Power{self.relay}" + (f" {action}" if action else "")))

    def set_max_on(self, seconds: float | None) -> None:
        """Arm (or with 0/None clear) the plug's own switch-off timer, which
        runs from every switch-on until cleared, even if the host is gone."""
        value = pulsetime_value(seconds) if seconds else 0
        self.cmd(f"PulseTime{self.relay} {value}")

    def energy(self) -> dict:
        e = self.cmd("Status 8").get("StatusSNS", {}).get("ENERGY", {})
        return {"watts": e.get("Power"), "volts": e.get("Voltage"), "amps": e.get("Current"),
                "kwh_today": e.get("Today")}

    def status(self) -> dict:
        return {"relay": self.power()} | self.energy()


def make_power(bench: dict):
    conf = bench.get("power") or {}
    kind = conf.get("type")
    if kind == "tasmota":
        return Tasmota(conf)
    raise BenchError(f"unsupported power type: {kind!r}")


def arm_max_on(psu, override: float | None = None) -> None:
    """Set the plug's dead-man (PulseTime) before a switch-on: the --max-on
    value if given (0 clears it), else the bench's max_on_seconds. Without
    either, the plug's setting is left alone."""
    secs = override if override is not None else getattr(psu, "max_on", None)
    if secs is not None:
        psu.set_max_on(secs)


# Time the plug gets, after the off time, to report the relay closed again
# during a plug-side cycle.
PLUG_CYCLE_GRACE = 10.0


def wait_relay(psu, state: str, timeout: float, interval: float = 0.5) -> bool:
    deadline = time.monotonic() + timeout
    while True:
        if psu.power() == state:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(interval)


def plug_side_cycle(psu, off_seconds: float, while_off=None) -> float:
    """Let the plug run Off; Delay; On itself (Backlog), so the cycle finishes
    even if the host dies halfway. The host sends nothing to the plug until
    the off time is over: on a real plug (Tasmota 14.3) any command received
    during a Backlog Delay changed it (polling every 0.5 s cut 3 s to 0.6 s,
    every 0.05 s stalled it for over 15 s). So the returned time is when ON
    was confirmed, not when the relay closed; boot timing never uses this.
    The host switches the relay on itself only as a fallback."""
    if not 0.2 <= off_seconds <= 360:
        raise BenchError("plug-side cycle: off time must be 0.2..360 s (Tasmota Delay)")
    r, t_on = psu.relay, None
    try:
        sent = time.monotonic()
        psu.cmd(f"Backlog Power{r} Off; Delay {round(off_seconds * 10)}; Power{r} On")
        # Quiet from here until the Delay is over. Off runs first, so the
        # relay is open after a short moment; while_off doesn't touch the plug.
        time.sleep(min(0.5, off_seconds / 2))
        if while_off:
            while_off()
        time.sleep(max(0.0, off_seconds + 1.0 - (time.monotonic() - sent)))
        if wait_relay(psu, "ON", PLUG_CYCLE_GRACE):
            t_on = time.monotonic()
    finally:
        if t_on is None:
            state = psu.power("On")  # fallback: never leave the board dark
    if t_on is None:
        raise BenchError(f"plug-side cycle: relay not back on in time (host fallback: {state})")
    return t_on


def power_cycle(psu, off_seconds: float, while_off=None, max_on: float | None = None,
                plug_side: bool = False) -> float:
    """Off, wait, on. Returns the monotonic time the relay closed.
    while_off runs with the relay open (e.g. to drop the old run's UART bytes).
    plug_side: let a bench with cycle_on_plug run the cycle on the plug
    (only `hil power cycle`; boot and uboot need the exact relay-close time)."""
    arm_max_on(psu, max_on)
    if plug_side and getattr(psu, "plug_cycle", False):
        return plug_side_cycle(psu, off_seconds, while_off)
    try:
        # Inside the try: if the relay opened but the reply was lost, the
        # finally still closes it again.
        psu.power("Off")
        time.sleep(off_seconds)
        if while_off:
            while_off()
    finally:
        # Never leave the board dark because the host run was interrupted.
        state = psu.power("On")
    if state != "ON":
        raise BenchError(f"relay did not close (state {state})")
    return time.monotonic()


# The plug's meter refreshes about once a second and is only as good as its
# calibration (see docs/nous-a8t.md); treat watts as indicative, not lab data.

def power_summary(samples: list[dict]) -> dict:
    """avg/min/max watts and trapezoid-integrated Wh over [{"t", "watts"}, ...]."""
    pts = [(s["t"], s["watts"]) for s in samples if s.get("watts") is not None]
    if not pts:
        return {"samples": 0}
    w = [p[1] for p in pts]
    joules = sum((t2 - t1) * (w1 + w2) / 2 for (t1, w1), (t2, w2) in zip(pts, pts[1:]))
    span = pts[-1][0] - pts[0][0]
    # Time-weighted, so it agrees with wh even when the sample spacing drifts.
    avg = joules / span if span > 0 else statistics.fmean(w)
    return {"samples": len(pts), "avg_w": round(avg, 2), "min_w": min(w),
            "max_w": max(w), "wh": round(joules / 3600, 4), "span_s": round(span, 2)}


def check_interval(x: float | None, flag: str) -> None:
    if x is not None and not (math.isfinite(x) and x > 0):
        raise BenchError(f"{flag} must be a positive number of seconds")


class PowerSampler:
    """Polls the plug's meter in a thread, timed from t0 (relay close)."""

    def __init__(self, psu, interval: float, t0: float):
        self.psu, self.interval, self.t0 = psu, interval, t0
        self.samples: list[dict] = []
        self.error: str | None = None
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._run, daemon=True)

    def _run(self) -> None:
        while not self._stop.is_set():
            tick = time.monotonic()
            try:
                e = self.psu.energy()
            except Exception as err:  # a dropped reading must not fail the boot
                self.error = f"{type(err).__name__}: {err}"
            else:
                self.samples.append({"t": round(time.monotonic() - self.t0, 2), "watts": e["watts"]})
            self._stop.wait(max(0.0, self.interval - (time.monotonic() - tick)))

    def __enter__(self):
        self._thread.start()
        return self

    def __exit__(self, *exc):
        self._stop.set()
        self._thread.join(timeout=10)
        if self._thread.is_alive():
            self.error = "sampler still blocked on the plug after 10 s"

    def summary(self) -> dict:
        s = power_summary(self.samples) | {"interval_s": self.interval}
        return s | ({"error": self.error} if self.error else {})


# --------------------------------------------------------------------- serial

def serial_path(bench: dict) -> str:
    port = (bench.get("serial") or {}).get("port")
    if not port:
        raise BenchError("bench has no serial.port")
    return port


def port_holders(port: str) -> list[str]:
    """Processes with the tty open (tio, the MCP serial server, ...)."""
    real = os.path.realpath(port)
    holders = []
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            for fd in os.listdir(f"/proc/{pid}/fd"):
                if os.path.realpath(f"/proc/{pid}/fd/{fd}") == real:
                    comm = Path(f"/proc/{pid}/comm").read_text().strip()
                    holders.append(f"{comm}[{pid}]")
                    break
        except (PermissionError, FileNotFoundError, ProcessLookupError):
            continue
    return holders


def port_busy(port: str) -> list[str]:
    """Who else has the tty: processes we can inspect (/proc/<pid>/fd, same
    user), plus flock(2) holders from /proc/locks, which is world-readable
    and so also shows other users' tio or pyserial sessions."""
    holders = port_holders(port)
    for pid in flock_holders(os.path.realpath(port)):
        if not any(h.endswith(f"[{pid}]") for h in holders):
            holders.append(f"pid {pid} (flock on the tty, possibly another user)")
    return holders


def open_serial(bench: dict):
    try:
        import serial  # pyserial
    except ImportError:
        raise BenchError("pyserial not installed (python3 -m pip install --user pyserial)") from None
    port = serial_path(bench)
    if not os.path.exists(port):
        raise BenchError(f"serial port {port} not present")
    holders = port_busy(port)
    if holders:
        raise BenchError(f"{port} already open by {', '.join(holders)}; close it first "
                         "(serial_close for the MCP server, quit tio)")
    baud = int(bench["serial"].get("baud", 115200))
    try:
        return serial.Serial(port, baud, timeout=0.2, exclusive=True)
    except serial.SerialException as e:
        if e.errno == errno.EBUSY:
            raise BenchError(f"{port} is held exclusively (TIOCEXCL) by another process, "
                             "possibly another user's; close it first") from None
        if e.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
            raise BenchError(f"{port} is locked (flock) by another process; close it first") from None
        raise BenchError(f"cannot open {port}: {e}") from None


def log_paths(log_dir: str | None, name: str, kind: str) -> tuple[Path, Path]:
    d = Path(log_dir).expanduser() if log_dir else default_log_dir()
    d.mkdir(parents=True, exist_ok=True)
    stem = f"{name}-{kind}-{dt.datetime.now():%Y%m%d-%H%M%S}"
    return d / f"{stem}.log", d / f"{stem}.json"


# ------------------------------------------------------------------- commands

def cmd_power(args, name, bench) -> int:
    check_interval(args.off_seconds, "--off-seconds")
    if args.max_on is not None:
        if args.action not in ("on", "cycle"):
            raise BenchError("--max-on only applies to power on and power cycle")
        if args.max_on != 0:
            pulsetime_value(args.max_on)
    psu = make_power(bench)
    if args.action == "status":
        print(json.dumps(psu.status()))
        return 0
    if args.action == "watch":
        return power_watch(args, psu)
    with bench_lock(name, f"power {args.action}"):
        if args.action == "cycle":
            off = args.off_seconds if args.off_seconds is not None else float(bench["power"].get("off_seconds", 5))
            power_cycle(psu, off, max_on=args.max_on, plug_side=True)
            print(json.dumps({"relay": "ON", "cycled_off_seconds": off}))
        elif args.action == "on":
            arm_max_on(psu, args.max_on)
            print(json.dumps({"relay": psu.power("On")}))
        else:
            state = psu.power("Off")
            if getattr(psu, "max_on", None) is not None:
                psu.set_max_on(0)  # disarm, so a later plain "on" isn't cut
            print(json.dumps({"relay": state}))
    return 0


def power_watch(args, psu) -> int:
    """Sample W/V/A until --duration or Ctrl-C, then summarize. Read-only: no lock."""
    check_interval(args.interval, "--interval")
    check_interval(args.duration, "--duration")
    try:
        csv = Path(args.csv).expanduser().open("w") if args.csv else None
    except OSError as e:
        raise BenchError(f"cannot write --csv: {e}") from None
    if csv:
        csv.write("t_s,watts,volts,amps\n")
    samples, errors, t0 = [], 0, time.monotonic()
    try:
        while args.duration is None or time.monotonic() - t0 <= args.duration:
            tick = time.monotonic()
            try:
                s = {"t": round(tick - t0, 2)} | psu.energy()
            except BenchError as e:  # keep sampling; one dropped reading isn't fatal
                errors += 1
                print(f"hil: {e}", file=sys.stderr)
            else:
                samples.append(s)
                line = ",".join("" if v is None else str(v)
                                for v in (s["t"], s["watts"], s["volts"], s["amps"]))
                print(line, flush=True)
                if csv:
                    csv.write(line + "\n")
                    csv.flush()
            time.sleep(max(0.0, args.interval - (time.monotonic() - tick)))
    except KeyboardInterrupt:
        pass
    finally:
        if csv:
            csv.close()
    print(json.dumps(power_summary(samples) | ({"errors": errors} if errors else {})))
    return 0


class Console:
    """UART reader that logs raw bytes and keeps a decoded, searchable buffer.

    The buffer is capped, so offsets that outlive a pump() are absolute:
    `base` counts the characters trimmed off its front. mark() returns the
    current end as an absolute offset, local() turns one back into an index
    into `buf` (0 if that text was already trimmed)."""

    def __init__(self, ser, log, t0: float):
        self.ser, self.log, self.t0 = ser, log, t0
        self.buf = ""
        self.base = 0

    def mark(self) -> int:
        return self.base + len(self.buf)

    def local(self, pos: int) -> int:
        return min(max(0, pos - self.base), len(self.buf))

    def drop_before(self, pos: int) -> None:
        """Forget everything before absolute offset pos."""
        cut = self.local(pos)
        self.buf, self.base = self.buf[cut:], self.base + cut

    def elapsed(self) -> float:
        return round(time.monotonic() - self.t0, 2)

    def pump(self) -> str:
        chunk = self.ser.read(4096)
        if not chunk:
            return ""
        self.log.write(chunk)
        self.log.flush()
        text = chunk.decode("latin-1").replace("\r", "")
        self.buf += text
        if len(self.buf) > 1 << 20:  # bounded on chatty consoles
            self.drop_before(self.mark() - (1 << 16))
        return text

    def write(self, data: str) -> None:
        # Paced: the U-Boot UART has a small RX FIFO and no flow control.
        raw = data.encode()
        for i in range(0, len(raw), 8):
            self.ser.write(raw[i:i + 8])
            self.ser.flush()
            time.sleep(0.01)

    def expect(self, rx: re.Pattern, timeout: float, start: int | None = None):
        """Wait for rx in the buffer from absolute offset `start` (default: now).
        Returns the match (indices into the current `buf`) or None."""
        pos = self.mark() if start is None else start
        deadline = time.monotonic() + timeout
        while True:
            m = rx.search(self.buf, self.local(pos))
            if m:
                return m
            if time.monotonic() >= deadline:
                return None
            self.pump()


def stage_config(bench: dict, timeout: float | None):
    boot = bench.get("boot") or {}
    stages = boot.get("stages") or DEFAULT_STAGES
    compiled = [(s["name"], re.compile(s["pattern"], re.M), bool(s.get("optional"))) for s in stages]
    # re.M for both lists, so ^ and $ mean line start/end everywhere.
    fails = [re.compile(p, re.M) for p in boot.get("fail_patterns", DEFAULT_FAIL)]
    return compiled, fails, timeout or float(boot.get("timeout", 180))


def watch_stages(con: Console, compiled, fails, timeout: float, result: dict) -> bool:
    """Match stages in order on the console (including what is already
    buffered). Optional stages may be silent; required ones decide PASS."""
    pos = idx = scanned = 0  # absolute offsets (see Console)
    while idx < len(compiled) and time.monotonic() - con.t0 < timeout:
        # Fail patterns: scan only new text (with overlap for split lines).
        fail = next((m for f in fails if (m := f.search(con.buf, con.local(scanned - 200)))), None)
        scanned = con.mark()
        if fail:
            result["fail_match"] = fail.group(0)
            break
        progressed = False
        for j in range(idx, len(compiled)):
            sname, rx, optional = compiled[j]
            m = rx.search(con.buf, con.local(pos))
            if m:
                result["missed"] += [compiled[k][0] for k in range(idx, j)]
                result["stages"][sname] = con.elapsed()
                pos, idx, progressed = con.base + m.end(), j + 1, True
                break
            if not optional:
                break
        if not progressed:
            con.pump()
    result["missed"] += [c[0] for c in compiled[idx:]]
    required = {c[0] for c in compiled if not c[2]}
    return result["fail_match"] is None and required <= result["stages"].keys()


def stages_already_seen(compiled, text: str) -> list[str]:
    """Names of the stages that `text` already shows, walked in order the way
    watch_stages does: an optional stage may be absent, a missing required
    one ends the run. Used for the part of a boot printed before an
    autoboot interrupt, which won't repeat after `boot`."""
    seen, pos = [], 0
    for sname, rx, optional in compiled:
        m = rx.search(text, pos)
        if m:
            seen.append(sname)
            pos = m.end()
        elif not optional:
            break
    return seen


def print_stages(result: dict) -> None:
    if result.get("before_interrupt"):
        print(f"     ---   {', '.join(result['before_interrupt'])} (before the autoboot interrupt)")
    prev = 0.0
    for sname, t in result["stages"].items():
        print(f"  {t:7.2f}s  (+{t - prev:6.2f}s)  {sname}")
        prev = t
    for sname in result["missed"]:
        print(f"     ---   {sname} (not seen)")
    if result.get("power"):
        p = result["power"]
        if p.get("samples"):
            print(f"  power: avg {p['avg_w']} W, peak {p['max_w']} W, {p['wh']} Wh over {p['span_s']}s "
                  f"({p['samples']} samples)")
        if p.get("error"):
            print(f"  power: sampling error: {p['error']}")
    if result.get("fail_match"):
        print(f"  FAIL pattern: {result['fail_match']!r}")


def start_console(args, name, bench, ser, log) -> Console:
    if args.no_cycle:
        ser.reset_input_buffer()
        return Console(ser, log, time.monotonic())
    off = float(bench["power"].get("off_seconds", 5))
    # Clear while the relay is open, so the previous run's tail can't leak in.
    return Console(ser, log, power_cycle(make_power(bench), off, ser.reset_input_buffer))


def boot_once(args, name, bench, ser, compiled, fails, timeout, kind: str) -> dict:
    log_path, json_path = log_paths(args.log_dir, name, kind)
    result = {"bench": name, "started": now_iso(), "log": str(log_path),
              "cycled": not args.no_cycle, "stages": {}, "missed": [], "fail_match": None}
    try:
        with log_path.open("wb") as log:
            con = start_console(args, name, bench, ser, log)
            if args.power_interval:
                with PowerSampler(make_power(bench), args.power_interval, con.t0) as ps:
                    ok = watch_stages(con, compiled, fails, timeout, result)
                result["power"] = ps.summary()
            else:
                ok = watch_stages(con, compiled, fails, timeout, result)
            result["elapsed"] = con.elapsed()
    except BenchError as e:
        # Bench/infra failure (plug, port): still leave a record of the run.
        result |= {"error": str(e), "result": "ERROR"}
        json_path.write_text(json.dumps(result, indent=2) + "\n")
        raise
    result["result"] = "PASS" if ok else "FAIL"
    json_path.write_text(json.dumps(result, indent=2) + "\n")
    return result


def series_stats(runs: list[dict]) -> dict:
    """Per-stage min/median/max/stdev over the runs that reached each stage."""
    stats = {}
    for sname in dict.fromkeys(s for r in runs for s in r["stages"]):
        ts = [r["stages"][sname] for r in runs if sname in r["stages"]]
        stats[sname] = {"n": len(ts), "min": min(ts), "median": round(statistics.median(ts), 2),
                        "max": max(ts), "stdev": round(statistics.stdev(ts), 2) if len(ts) > 1 else 0.0}
    whs = [r["power"]["wh"] for r in runs if r.get("power", {}).get("samples")]
    if whs:
        stats["energy_wh"] = {"n": len(whs), "min": min(whs), "median": round(statistics.median(whs), 4),
                              "max": max(whs)}
    return stats


def cmd_boot(args, name, bench) -> int:
    if args.repeat < 1:
        raise BenchError("--repeat must be >= 1")
    if args.repeat > 1 and args.no_cycle:
        raise BenchError("--repeat needs power cycles; drop --no-cycle")
    check_interval(args.power_interval, "--power-interval")
    if args.settle < 0 or not math.isfinite(args.settle):
        raise BenchError("--settle must be >= 0 seconds")
    compiled, fails, timeout = stage_config(bench, args.timeout)

    runs, aborted, interrupted = [], None, False
    with bench_lock(name, "boot" if args.repeat == 1 else f"boot x{args.repeat}"), \
            open_serial(bench) as ser:
        try:
            for i in range(args.repeat):
                kind = "boot" if args.repeat == 1 else f"boot-r{i + 1:02d}"
                r = boot_once(args, name, bench, ser, compiled, fails, timeout, kind)
                runs.append(r)
                if not args.json:
                    if args.repeat > 1:
                        print(f"run {i + 1}/{args.repeat}")
                    print_stages(r)
                    print(f"{r['result']}  {name}  ({r['elapsed']}s)  log: {r['log']}")
                if i + 1 < args.repeat:
                    # Leave the board up, e.g. so an A/B scheme can mark the
                    # slot good before the next power cut.
                    time.sleep(args.settle)
        except (BenchError, KeyboardInterrupt) as e:
            if args.repeat == 1:
                raise
            aborted, interrupted = f"{type(e).__name__}: {e}", isinstance(e, KeyboardInterrupt)

    if args.repeat == 1:
        if args.json:
            print(json.dumps(runs[0]))
        return 0 if runs[0]["result"] == "PASS" else 1

    passed = sum(r["result"] == "PASS" for r in runs)
    series = {"bench": name, "runs": len(runs), "requested": args.repeat, "passed": passed,
              "settle_s": args.settle, "stats": series_stats(runs), "logs": [r["log"] for r in runs]}
    if aborted:
        series["aborted"] = aborted
    _, json_path = log_paths(args.log_dir, name, "boot-series")
    json_path.write_text(json.dumps(series, indent=2) + "\n")
    if aborted:
        print(f"hil: series aborted after {len(runs)}/{args.repeat} runs: {aborted}", file=sys.stderr)
        print(f"partial summary: {json_path}", file=sys.stderr)
        return 130 if interrupted else 2
    if args.json:
        print(json.dumps(series))
    else:
        print(f"\n{'stage':16} {'n':>3} {'min':>8} {'median':>8} {'max':>8} {'stdev':>7}")
        for sname, s in series["stats"].items():
            print(f"{sname:16} {s['n']:3} {s['min']:8} {s['median']:8} {s['max']:8} {s.get('stdev', ''):>7}")
        print(f"{passed}/{len(runs)} PASS  {name}  summary: {json_path}")
    return 0 if passed == len(runs) else 1


# ------------------------------------------------------------- U-Boot rescue

# Prompt text names its own stop string on keyed autoboot ("type 'abc' to
# stop", "Type 'abc' within 3 seconds"); plain autoboot says "Hit any key".
AUTOBOOT_RX = re.compile(r"[Tt]ype '([^']+)'[^\n]*(?:stop|autoboot)|Hit any key to stop autoboot")
# Seen before any autoboot prompt => autoboot is not interruptible (e.g. a
# BOOTDELAY=-2 production lockdown) and the window has passed.
# Extend per bench with [uboot] too_late_patterns (e.g. a bootcmd's own log tag).
TOO_LATE_DEFAULT = [r"## Loading kernel", r"Starting kernel", r"Booting Linux"]
UBOOT_PROMPT = r"(?:U-Boot> |=> )"
# Commands that can destroy a card or the env, lock the board out of hil
# (bootdelay/bootcmd + saveenv), burn OTP, or poke memory and buses; they
# need --allow-destructive. A denylist on command text can't see through
# hush variables or `run`, so both count as destructive too.
DESTRUCTIVE_RX = re.compile(
    r"\b(?:mmc\s+(?:write|erase|swrite|part|partconf|bootbus|rst)|erase|gpt\s+write"
    r"|fatwrite|ext4write|fatrm|sf\s+(?:erase|write|update)|ums|dfu|fastboot|nand\s+(?:erase|write)"
    r"|saveenv|editenv|env\s+(?:default|save|erase|edit|import)"
    r"|(?:setenv|setexpr|env\s+(?:set|delete))\s+(?:-f\s+)?(?:bootdelay|bootcmd)\b"
    r"|fuse|(?:mw|nm|mm)(?:\.[bwlq])?|i2c\s+(?:mw|nm|mm|write)|run)\b"
    r"|\$")
# Hush syntax that chains, expands or quotes. Refused outright for agents,
# before the allowlist is matched, so "setenv BOOT_*" can't smuggle a ";".
SHELL_SYNTAX_RX = re.compile(r"[;&|$'\"\\`#{}<>\n\r]")
# RAUC's U-Boot boot-selection convention; only used when [uboot] ab = "rauc".
RAUC_VARS = ["BOOT_ORDER", "BOOT_A_LEFT", "BOOT_B_LEFT"]


class UbootError(Exception):
    """The target did not reach / cooperate at the U-Boot shell (exit 1)."""


def is_destructive(cmd: str) -> bool:
    return bool(DESTRUCTIVE_RX.search(cmd))


def agent_command_refusal(cmd: str, allow: list[str]) -> str | None:
    """Why an agent may not run cmd at the U-Boot prompt, or None if it may.
    The command must be plain words, match a bench `[uboot] allow` glob, and
    not be destructive (the denylist stays as a second check)."""
    if not re.fullmatch(r"[\x20-\x7e]*", cmd):
        # Backspace, Ctrl-U, Ctrl-C, tab, escape sequences would edit the line
        # at the prompt after the allowlist had matched it.
        return f"{cmd!r} contains characters that aren't printable ASCII"
    if SHELL_SYNTAX_RX.search(cmd):
        return f"{cmd!r} uses shell syntax (; & | $ quotes \\ ` # {{}} <>)"
    words = " ".join(cmd.split())
    if not allow:
        return "no [uboot] allow list for this bench, so agents can't use 'run'"
    if not any(fnmatch.fnmatchcase(words, pat) for pat in allow):
        return f"{words!r} is not in the bench's [uboot] allow list"
    if is_destructive(words):
        return f"{words!r} is destructive"
    return None


def uboot_interrupt(con: Console, bench: dict, stop: str | None, timeout: float) -> dict:
    """Catch the autoboot countdown and stop it. Returns what was seen."""
    conf = bench.get("uboot") or {}
    too_late = re.compile("|".join(TOO_LATE_DEFAULT + conf.get("too_late_patterns", [])))
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        m = AUTOBOOT_RX.search(con.buf)
        if m:
            key = stop or conf.get("stop_string") or m.group(1) or " "
            after = con.base + m.end()
            con.write(key)
            if not con.expect(re.compile(UBOOT_PROMPT + r"$"), 5, start=after):
                # Some builds want a newline after a keyed string.
                con.write("\r")
                if not con.expect(re.compile(UBOOT_PROMPT + r"$"), 3, start=after):
                    raise UbootError(f"sent stop string {key!r} but got no U-Boot prompt")
            return {"autoboot_prompt": m.group(0), "stop_string": key, "at": con.elapsed()}
        if too_late.search(con.buf):
            raise UbootError("autoboot was not interruptible (no countdown before kernel load; "
                             "production BOOTDELAY=-2 lockdown?)")
        con.pump()
    raise UbootError(f"no autoboot prompt within {timeout:.0f}s")


def uboot_cmd(con: Console, cmd: str, timeout: float = 10) -> dict:
    """Type a command, verify the echo, then execute it and capture output."""
    if "\n" in cmd or "\r" in cmd:
        raise BenchError("one U-Boot command per line")
    for _attempt in (1, 2):
        mark = con.mark()
        con.write(cmd)
        echo_rx = re.compile(re.escape(cmd) + r"$")
        if con.expect(echo_rx, 3, start=mark):
            break
        con.write("\x03")  # Ctrl-C: discard the garbled line, get a fresh prompt
        con.expect(re.compile(UBOOT_PROMPT + r"$"), 3, start=mark)
    else:
        raise UbootError(f"echo mismatch twice for {cmd!r}; not executed")
    mark = con.mark()
    con.write("\r")
    m = con.expect(re.compile(UBOOT_PROMPT + r"$"), timeout, start=mark)
    if not m:
        raise UbootError(f"no prompt after {cmd!r} within {timeout:.0f}s")
    out = con.buf[con.local(mark):m.start()].strip("\n")
    return {"cmd": cmd, "output": out}


def uboot_rc(con: Console, cmd: str, timeout: float = 10) -> dict:
    """Run cmd and capture its exit status via hush's $? (None if unsupported)."""
    r = uboot_cmd(con, cmd, timeout)
    rc = uboot_cmd(con, "echo HILRC=$?")["output"]
    m = re.search(r"HILRC=(\d+)", rc)
    r["rc"] = int(m.group(1)) if m else None
    return r


def env_vars(bench: dict) -> list[str]:
    conf = bench.get("uboot") or {}
    extra = conf.get("env_vars", [])
    if not (isinstance(extra, list) and all(isinstance(v, str) for v in extra)):
        raise BenchError("[uboot] env_vars must be a list of variable names")
    return (RAUC_VARS if conf.get("ab") == "rauc" else []) + extra


def read_env(con: Console, names: list[str]) -> dict:
    env = {}
    for var in names:
        out = uboot_cmd(con, f"printenv {var}")["output"]
        m = re.search(rf"^{var}=(.*)$", out, re.M)
        env[var] = m.group(1).strip() if m else None
    return env


def uboot_policy_check(args, bench) -> None:
    """Refuse what the caller may not do before anything touches the bench."""
    conf = bench.get("uboot") or {}
    if not 1 <= args.attempts <= 99:
        raise BenchError("--attempts must be between 1 and 99")
    if args.caller == "agent":
        if args.allow_destructive:
            raise BenchError("caller policy is 'agent': --allow-destructive is refused")
        if args.action == "shell":
            raise BenchError("caller policy is 'agent': 'uboot shell' (raw console) is refused")
        if args.stop_string:
            raise BenchError("caller policy is 'agent': --stop-string is refused "
                             "(set [uboot] stop_string in the bench config)")
        if args.action == "run":
            allow = conf.get("allow", [])
            if not (isinstance(allow, list) and all(isinstance(a, str) for a in allow)):
                raise BenchError("[uboot] allow must be a list of glob patterns")
            for c in args.commands:
                why = agent_command_refusal(c, allow)
                if why:
                    raise BenchError(f"caller policy is 'agent': {why}")
    elif args.action == "run":
        bad = [c for c in args.commands if is_destructive(c)]
        if bad and not args.allow_destructive:
            raise BenchError(f"refusing destructive command(s) {bad} without --allow-destructive")


def cmd_uboot(args, name, bench) -> int:
    ab = (bench.get("uboot") or {}).get("ab")
    if args.action in ("slot", "reset-counters") and ab != "rauc":
        raise BenchError(f"'{args.action}' needs an A/B scheme: set [benches.{name}.uboot] ab = \"rauc\"")
    if args.action == "slot" and args.slot not in ("A", "B"):
        raise BenchError("slot must be A or B")
    if args.action == "run" and not args.commands:
        raise BenchError("run needs at least one command")
    uboot_policy_check(args, bench)
    then = "console" if args.action == "shell" else args.then
    attempts = str(args.attempts)

    log_path, json_path = log_paths(args.log_dir, name, "uboot")
    result = {"bench": name, "started": now_iso(), "log": str(log_path), "action": args.action,
              "cycled": not args.no_cycle, "commands": [], "then": then,
              "stages": {}, "missed": [], "fail_match": None}
    ok = False
    try:
        with bench_lock(name, f"uboot {args.action}"), open_serial(bench) as ser, \
                log_path.open("wb") as log:
            con = start_console(args, name, bench, ser, log)
            result["interrupt"] = uboot_interrupt(con, bench, args.stop_string, args.prompt_timeout)
            names = env_vars(bench)
            result["env_before"] = read_env(con, names)

            if args.action == "slot":
                other = "B" if args.slot == "A" else "A"
                steps = [f"setenv BOOT_ORDER {args.slot} {other}",
                         f"setenv BOOT_A_LEFT {attempts}", f"setenv BOOT_B_LEFT {attempts}", "saveenv"]
            elif args.action == "reset-counters":
                steps = [f"setenv BOOT_A_LEFT {attempts}", f"setenv BOOT_B_LEFT {attempts}", "saveenv"]
            elif args.action == "run":
                steps = args.commands
            elif args.action == "env" and not names:
                steps = ["printenv"]  # nothing configured to pick out: dump it all
            else:  # env, shell
                steps = []
            for c in steps:
                r = uboot_rc(con, c, timeout=args.cmd_timeout)
                result["commands"].append(r)
                if r["rc"] not in (0, None):
                    raise UbootError(f"{c!r} failed (rc={r['rc']}): {r['output'][-200:]}")
            if args.action in ("slot", "reset-counters"):
                result["env_after"] = read_env(con, names)

            if then == "boot":
                compiled, fails, timeout = stage_config(bench, args.timeout)
                # Stages already passed before the interrupt (eeprom, U-Boot
                # banner) won't repeat, required or not; judge only the rest.
                seen = stages_already_seen(compiled, con.buf)
                result["before_interrupt"] = seen
                compiled = [c for c in compiled if c[0] not in seen]
                mark = con.mark()
                con.write("boot\r")
                con.drop_before(mark)  # judge only the boot we just started
                ok = watch_stages(con, compiled, fails, con.elapsed() + timeout, result)
            elif then == "reset":
                con.write("reset\r")
                ok = True
            else:  # stay / console: leave the board at the U-Boot prompt
                ok = True
            result["elapsed"] = con.elapsed()
    except UbootError as e:
        result["error"] = str(e)
        if "interrupt" in result:
            result["error"] += " -- board left at the U-Boot prompt (hil power cycle to recover)"
    except BenchError as e:
        # Bench/infra failure (plug, port): still leave a record of the run.
        result |= {"error": str(e), "result": "ERROR"}
        if not log_path.exists():
            result["log"] = None
        json_path.write_text(json.dumps(result, indent=2) + "\n")
        raise

    result["result"] = "PASS" if ok else "FAIL"
    json_path.write_text(json.dumps(result, indent=2) + "\n")
    if args.json:
        print(json.dumps(result))
    else:
        if "interrupt" in result:
            i = result["interrupt"]
            print(f"  {i['at']:7.2f}s  stopped autoboot with {i['stop_string']!r}")
        for key in ("env_before", "env_after"):
            if result.get(key):
                env = " ".join(f"{k}={v}" for k, v in result[key].items() if v is not None)
                print(f"  {key}: {env or '(none of the configured vars set)'}")
        for r in result["commands"]:
            print(f"  $ {r['cmd']}  [rc={r['rc']}]")
            for line in r["output"].splitlines():
                print(f"      {line}")
        if then == "boot":
            print_stages(result)
        if "error" in result:
            print(f"  ERROR: {result['error']}")
        print(f"{result['result']}  {name}  uboot {args.action} (then {then})  log: {log_path}")

    if ok and then == "console":
        return cmd_console(args, name, bench)
    return 0 if ok else 1


def cmd_wait_ssh(args, name, bench) -> int:
    ssh = bench.get("ssh") or {}
    host = args.host or os.environ.get("HIL_TARGET") or ssh.get("host")
    if not host:
        raise BenchError("no ssh host (--host, HIL_TARGET, or ssh.host)")
    port = int(ssh.get("port", 22))
    deadline = time.monotonic() + (args.timeout or float(ssh.get("timeout", 120)))
    while time.monotonic() < deadline:
        try:
            with socket.create_connection((host, port), timeout=2) as s:
                s.settimeout(3)
                if s.recv(64).startswith(b"SSH-"):
                    print(f"ssh up: {host}:{port}")
                    return 0
        except OSError:
            pass
        time.sleep(2)
    print(f"ssh not reachable: {host}:{port}", file=sys.stderr)
    return 1


def cmd_console(args, name, bench) -> int:
    if args.caller == "agent":
        raise BenchError("caller policy is 'agent': the raw console (tio) is refused")
    tio = shutil.which("tio")
    if not tio:
        raise BenchError("tio not installed")
    port = serial_path(bench)
    holders = port_busy(port)
    if holders:
        raise BenchError(f"{port} already open by {', '.join(holders)}")
    log_dir = Path(args.log_dir).expanduser() if args.log_dir else default_log_dir()
    log_dir.mkdir(parents=True, exist_ok=True)
    baud = str(bench["serial"].get("baud", 115200))
    os.execv(tio, [tio, "-b", baud, "--log", "--log-directory", str(log_dir), port])


def cmd_lock(args, name, bench) -> int:
    """Read-only: who holds the bench lock (see docs/bench-lock.md)."""
    path = lock_path(name)
    pids = flock_holders(path)
    try:
        line = path.read_text(errors="replace").partition("\n")[0].strip()
    except OSError:
        line = ""
    info = {"bench": name, "lock": str(path), "held": bool(pids), "holder_pids": pids}
    info |= {"holder": line} if pids else {"last_holder": line or None}
    print(json.dumps(info))
    return 0


def cmd_hold(args, name, bench) -> int:
    """Run a command (flasher, installer, test script) under the bench lock,
    so no other hil call can cut power or take the UART meanwhile."""
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        raise BenchError("hold needs a command: hil hold -- CMD [ARGS...]")
    with bench_lock(name, f"hold: {shlex.join(command)[:120]}") as fd:
        # The child (and any hil it runs on this bench) inherits the lock.
        env = os.environ | {"HIL_BENCH": name, "HIL_LOCK_FD": str(fd)}
        try:
            proc = subprocess.Popen(command, env=env, pass_fds=(fd,))
        except OSError as e:
            raise BenchError(f"cannot run {command[0]}: {e}") from None
        while True:
            try:
                rc = proc.wait()
                break
            except KeyboardInterrupt:
                # The child got the same SIGINT; keep the lock until it exits.
                continue
    return 128 - rc if rc < 0 else rc


def cmd_benches(args, cfg) -> int:
    default = cfg.get("default_bench")
    for n, b in cfg.get("benches", {}).items():
        mark = "*" if n == default else " "
        port = (b.get("serial") or {}).get("port") or "no serial"
        print(f"{mark} {n:12} {b.get('description', '')}  [{port}]")
    return 0


# ------------------------------------------------------------------- MCP

# A thin MCP server (JSON-RPC 2.0, one message per line, as on stdio) on a
# Unix socket. Every tool call becomes a fixed hil argv and runs through
# dispatch() with the agent policy forced and the config loaded at start,
# so it obeys the same lock, action log, allowlist and denylist as the CLI.
# There is deliberately no tool for console, hold, wait-ssh or raw U-Boot.

MCP_PROTOCOLS = ("2025-06-18", "2025-03-26", "2024-11-05")
_BENCH = {"type": "string", "pattern": r"^[A-Za-z0-9_.-]{1,64}$",
          "description": "bench name (default: the configured default_bench)"}


def _tool(name: str, description: str, props: dict | None = None, required: list | None = None) -> dict:
    schema = {"type": "object", "properties": props or {}, "additionalProperties": False}
    if required:
        schema["required"] = required
    return {"name": name, "description": description, "inputSchema": schema}


MCP_TOOLS = [
    _tool("benches", "List the configured benches."),
    _tool("lock_status", "Who holds a bench's lock (read-only).", {"bench": _BENCH}),
    _tool("power_status", "Relay state and W/V/A of a bench's plug (read-only).", {"bench": _BENCH}),
    _tool("power", "Switch a bench's power: on, off or cycle. Takes the bench lock.",
          {"bench": _BENCH, "action": {"type": "string", "enum": ["on", "off", "cycle"]}}, ["action"]),
    _tool("boot", "Power-cycle the board (unless no_cycle) and check its boot stages on the UART. "
          "Returns the JSON summary; isError means the boot failed or the bench refused.",
          {"bench": _BENCH, "timeout": {"type": "number", "minimum": 1, "maximum": 3600},
           "no_cycle": {"type": "boolean"}}),
    _tool("uboot", "Stop autoboot and work at the U-Boot prompt: read the env, select an A/B slot, "
          "reset boot counters, or run commands from the bench's allowlist. "
          "Then boot (default), stay at the prompt, or reset.",
          {"bench": _BENCH, "action": {"type": "string", "enum": ["env", "slot", "reset-counters", "run"]},
           "slot": {"type": "string", "enum": ["A", "B"]},
           "commands": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 20},
           "then": {"type": "string", "enum": ["boot", "stay", "reset"]}}, ["action"]),
]


class McpInvalidParams(Exception):
    pass


def mcp_check_args(tool: dict, args) -> None:
    schema = tool["inputSchema"]
    if not isinstance(args, dict):
        raise McpInvalidParams("arguments must be an object")
    unknown = set(args) - set(schema["properties"])
    if unknown:
        raise McpInvalidParams(f"unknown argument(s) for {tool['name']}: {', '.join(sorted(unknown))}")
    missing = set(schema.get("required", [])) - set(args)
    if missing:
        raise McpInvalidParams(f"missing argument(s): {', '.join(sorted(missing))}")
    for key, val in args.items():
        spec = schema["properties"][key]
        kind = spec["type"]
        if kind == "number":
            # Type first: math.isfinite() raises OverflowError on huge JSON ints.
            try:
                ok = isinstance(val, (int, float)) and not isinstance(val, bool) and math.isfinite(val)
            except OverflowError:
                ok = False
        else:
            ok = {"string": isinstance(val, str), "boolean": isinstance(val, bool),
                  "array": isinstance(val, list)}[kind]
        if ok and kind == "string":
            ok = ("enum" not in spec or val in spec["enum"]) and \
                 ("pattern" not in spec or re.match(spec["pattern"], val) is not None)
        if ok and kind == "number":
            ok = spec.get("minimum", -math.inf) <= val <= spec.get("maximum", math.inf)
        if ok and kind == "array":
            ok = len(val) <= spec.get("maxItems", 100) and all(
                isinstance(v, str) and len(v) <= spec["items"].get("maxLength", 1000) for v in val)
        if not ok:
            raise McpInvalidParams(f"invalid value for {key!r}")


def mcp_argv(name: str, a: dict) -> list[str]:
    """Tool arguments -> hil argv. Values go in --opt=VALUE form, so a value
    starting with '-' can't turn into another option."""
    argv = [f"--bench={a['bench']}"] if "bench" in a else []
    if name == "benches":
        return ["benches"]
    if name == "lock_status":
        return argv + ["lock"]
    if name == "power_status":
        return argv + ["power", "status"]
    if name == "power":
        return argv + ["power", a["action"]]
    if name == "boot":
        argv += ["boot", "--json"] + ([f"--timeout={a['timeout']}"] if "timeout" in a else [])
        return argv + (["--no-cycle"] if a.get("no_cycle") else [])
    if name == "uboot":
        argv += ["uboot", a["action"]] + ([a["slot"]] if "slot" in a else [])
        argv += [f"--cmd={c}" for c in a.get("commands", [])]
        return argv + [f"--then={a.get('then', 'boot')}", "--json"]
    raise McpInvalidParams(f"unknown tool {name!r}")


class McpServer:
    def __init__(self, path, cfg: dict, mode: int = 0o600):
        self.path, self.cfg, self.mode = Path(path), cfg, mode
        self.sock: socket.socket | None = None
        self.stopping = threading.Event()

    def request_stop(self) -> None:
        """Finish the current call (if any), answer it, then stop serving."""
        self.stopping.set()

    def _stop(self, stop: threading.Event | None) -> bool:
        return self.stopping.is_set() or bool(stop and stop.is_set())

    def bind(self) -> None:
        if os.path.lexists(self.path):
            if not stat.S_ISSOCK(os.lstat(self.path).st_mode):
                raise BenchError(f"{self.path} exists and is not a socket")
            probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                probe.connect(str(self.path))
            except OSError:
                os.unlink(self.path)  # stale socket from an earlier run
            else:
                raise BenchError(f"{self.path}: a server is already listening")
            finally:
                probe.close()
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o177)  # never world- or group-accessible, even briefly
        try:
            sock.bind(str(self.path))
        except OSError as e:
            sock.close()
            raise BenchError(f"cannot listen on {self.path}: {e}") from None
        finally:
            os.umask(old)
        os.chmod(self.path, self.mode)
        sock.listen(4)
        sock.settimeout(0.5)
        self.sock = sock

    def close(self) -> None:
        if self.sock:
            self.sock.close()
            self.sock = None
            with contextlib.suppress(FileNotFoundError):
                os.unlink(self.path)

    def serve(self, stop: threading.Event | None = None) -> None:
        """One client at a time; tool calls run one after the other."""
        try:
            while not self._stop(stop):
                try:
                    conn, _ = self.sock.accept()
                except TimeoutError:
                    continue
                with conn:
                    conn.settimeout(None)
                    self.handle(conn, stop)
        finally:
            self.close()

    def handle(self, conn: socket.socket, stop: threading.Event | None) -> None:
        f = conn.makefile("rwb")
        try:
            while not self._stop(stop):
                line = f.readline(1 << 20)
                if not line:
                    return
                if not line.endswith(b"\n"):
                    resp = self.error(None, -32600, "message too long")
                    f.write((json.dumps(resp) + "\n").encode())
                    f.flush()
                    return
                if not line.strip():
                    continue
                try:
                    msg = json.loads(line)
                except ValueError:
                    resp = self.error(None, -32700, "parse error")
                else:
                    resp = self.handle_msg(msg)
                if resp is not None:
                    f.write((json.dumps(resp) + "\n").encode())
                    f.flush()
        except (BrokenPipeError, ConnectionResetError):
            return
        finally:
            with contextlib.suppress(OSError):
                f.close()

    @staticmethod
    def error(mid, code: int, message: str) -> dict:
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": code, "message": message}}

    def handle_msg(self, msg) -> dict | None:
        if not isinstance(msg, dict) or msg.get("jsonrpc") != "2.0" or not isinstance(msg.get("method"), str):
            return self.error(msg.get("id") if isinstance(msg, dict) else None, -32600, "invalid request")
        mid, method, params = msg.get("id"), msg["method"], msg.get("params") or {}
        if "id" not in msg:
            return None  # notification (e.g. notifications/initialized)
        if method == "initialize":
            want = params.get("protocolVersion") if isinstance(params, dict) else None
            version = want if want in MCP_PROTOCOLS else MCP_PROTOCOLS[0]
            return {"jsonrpc": "2.0", "id": mid, "result": {
                "protocolVersion": version, "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": {"name": "hil", "version": "1"},
                "instructions": "Shared HIL bench control. Calls run with the agent caller policy."}}
        if method == "ping":
            return {"jsonrpc": "2.0", "id": mid, "result": {}}
        if method == "tools/list":
            return {"jsonrpc": "2.0", "id": mid, "result": {"tools": MCP_TOOLS}}
        if method == "tools/call":
            try:
                return {"jsonrpc": "2.0", "id": mid, "result": self.call(params)}
            except McpInvalidParams as e:
                return self.error(mid, -32602, str(e))
            except Exception as e:  # one bad request must never stop the server
                print(f"hil: mcp: internal error: {type(e).__name__}: {e}", file=sys.stderr)
                return self.error(mid, -32603, "internal error")
        return self.error(mid, -32601, f"method not found: {method}")

    def call(self, params) -> dict:
        if not isinstance(params, dict):
            raise McpInvalidParams("params must be an object")
        name = params.get("name")
        tool = next((t for t in MCP_TOOLS if t["name"] == name), None)
        if tool is None:
            raise McpInvalidParams(f"unknown tool {name!r}")
        args = params.get("arguments") or {}
        mcp_check_args(tool, args)
        argv = mcp_argv(name, args)
        try:
            parsed = build_parser().parse_args(argv)
        except SystemExit:
            raise McpInvalidParams("arguments rejected") from None
        parsed.via = "mcp"
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            try:
                rc = dispatch(parsed, argv, cfg=self.cfg, caller="agent")
            except Exception as e:  # keep serving; report it to the client
                rc = 2
                print(f"hil: internal error: {type(e).__name__}: {e}", file=sys.stderr)
        text = "\n".join(t for t in (out.getvalue().strip(), err.getvalue().strip()) if t)
        return {"content": [{"type": "text", "text": text or f"exit {rc}"}], "isError": rc != 0}


def cmd_mcp(args, cfg: dict) -> int:
    try:
        mode = int(args.socket_mode, 8)
    except ValueError:
        raise BenchError("--socket-mode must be octal, e.g. 600 or 660") from None
    if mode & ~0o660:
        raise BenchError("--socket-mode may grant owner/group read-write only (at most 660)")
    server = McpServer(Path(args.socket).expanduser(), cfg, mode)
    server.bind()

    def on_term(*_):
        # Stop like Ctrl-C: an interrupted call still runs its cleanup (relay
        # back on), its reply is sent, and the socket is removed.
        server.request_stop()
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    print(f"hil: MCP server on {server.path} (agent policy for every call)", file=sys.stderr)
    try:
        server.serve()
    except KeyboardInterrupt:
        pass
    return 0


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="hil", description=__doc__.split("\n\n")[0])
    ap.add_argument("-b", "--bench", help="bench name (default: HIL_BENCH or default_bench)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("power", help="relay control and energy reading")
    p.add_argument("action", choices=["status", "on", "off", "cycle", "watch"])
    p.add_argument("--off-seconds", type=float)
    p.add_argument("--max-on", type=float, metavar="S",
                   help="on/cycle: the plug switches itself off after S s (PulseTime dead-man; 0 clears it)")
    p.add_argument("--interval", type=float, default=1.0, help="watch: seconds between samples")
    p.add_argument("--duration", type=float, help="watch: stop after S seconds (default: Ctrl-C)")
    p.add_argument("--csv", help="watch: also write samples to this CSV file")

    p = sub.add_parser("boot", help="(power-cycle and) assert boot stages on the UART")
    p.add_argument("--no-cycle", action="store_true", help="watch a boot you trigger yourself")
    p.add_argument("--repeat", type=int, default=1,
                   help="boot N times and report per-stage min/median/max/stdev")
    p.add_argument("--settle", type=float, default=0.0,
                   help="--repeat: keep the board up S seconds after each run before the next cycle "
                        "(an A/B bench needs long enough to mark the slot good)")
    p.add_argument("--power-interval", type=float,
                   help="sample the plug's meter every S seconds during the boot "
                        "(avg/peak W and Wh until the stage watch ends)")
    p.add_argument("--timeout", type=float)
    p.add_argument("--log-dir")
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("uboot", help="stop autoboot and inspect/repair the U-Boot env")
    p.add_argument("action", choices=["env", "slot", "reset-counters", "run", "shell"])
    p.add_argument("slot", nargs="?", help="A or B (for 'slot')")
    p.add_argument("-c", "--cmd", dest="commands", action="append", default=[],
                   help="U-Boot command for 'run' (repeatable, executed in order)")
    p.add_argument("--then", choices=["boot", "stay", "reset"], default="boot",
                   help="after the action: boot and watch to login (default), stay at the prompt, or reset")
    p.add_argument("--attempts", type=int, default=3,
                   help="BOOT_x_LEFT value for slot/reset-counters (ab = \"rauc\" benches)")
    p.add_argument("--stop-string", help="override the autoboot stop string (auto-detected from the prompt)")
    p.add_argument("--allow-destructive", action="store_true",
                   help="permit erase/write/saveenv/env-default commands (refused for agent callers)")
    p.add_argument("--no-cycle", action="store_true", help="catch a reset you trigger yourself")
    p.add_argument("--prompt-timeout", type=float, default=60, help="seconds to wait for the autoboot prompt")
    p.add_argument("--cmd-timeout", type=float, default=15)
    p.add_argument("--timeout", type=float, help="boot-to-login timeout when --then boot")
    p.add_argument("--log-dir")
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("wait-ssh", help="wait until the target's sshd answers")
    p.add_argument("--host")
    p.add_argument("--timeout", type=float)

    p = sub.add_parser("console", help="interactive tio session with logging")
    p.add_argument("--log-dir")

    sub.add_parser("lock", help="show who holds the bench lock (read-only, JSON)")

    p = sub.add_parser("hold", help="run a command under the bench lock (flash, install, test script)")
    p.add_argument("command", nargs=argparse.REMAINDER, help="-- CMD [ARGS...]")

    sub.add_parser("benches", help="list configured benches")

    p = sub.add_parser("mcp", help="serve a small MCP tool set on a Unix socket (agent policy)")
    p.add_argument("--socket", required=True, help="Unix socket path to listen on")
    p.add_argument("--socket-mode", default="600", help="octal permissions of the socket (600 or 660)")
    return ap


def dispatch(args, argv: list[str], cfg: dict | None = None, caller: str | None = None) -> int:
    """Run parsed args. cfg: an already loaded config (else read it now).
    caller='agent' forces the agent policy; nothing can loosen it."""
    try:
        if cfg is None:
            cfg = load_config()
            apply_paths(cfg)
        if args.cmd == "benches":
            return cmd_benches(args, cfg)
        if args.cmd == "mcp":
            if caller == "agent":
                raise BenchError("mcp can't be started from an MCP call")
            return cmd_mcp(args, cfg)
        name, bench = get_bench(cfg, args.bench)
        args.caller = "agent" if caller == "agent" else caller_policy(cfg, bench)
        fn = {"power": cmd_power, "boot": cmd_boot, "uboot": cmd_uboot, "wait-ssh": cmd_wait_ssh,
              "console": cmd_console, "hold": cmd_hold, "lock": cmd_lock}[args.cmd]
        if is_recorded(args):
            return run_recorded(name, args, lambda: fn(args, name, bench), argv)
        return fn(args, name, bench)
    except BenchLocked as e:
        print(f"hil: {e}", file=sys.stderr)
        return 3
    except BenchError as e:
        print(f"hil: {e}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


def main() -> int:
    argv = sys.argv[1:]
    return dispatch(build_parser().parse_args(argv), argv)


if __name__ == "__main__":
    sys.exit(main())

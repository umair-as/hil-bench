# Copy to ~/.config/hil-bench/benches.toml (or point HIL_BENCH_CONFIG at it).
# Host-local: IPs, serial IDs and credential paths never go in a project repo.

default_bench = "rpi5"

[benches.rpi5]
description = "Raspberry Pi 5 on Tasmota plug"

[benches.rpi5.power]
type = "tasmota"
host = "192.0.2.10"                 # plug IP
creds_file = "~/.config/tasmota"    # TASMOTA_USER= / TASMOTA_PASS= lines
relay = 1
off_seconds = 5                     # let the PSU caps drain

[benches.rpi5.serial]
# Use the stable /dev/serial/by-id path, not ttyACMn.
port = "/dev/serial/by-id/usb-XXXX-if00"
baud = 115200

[benches.rpi5.ssh]
host = ""          # optional; override per run with --host or HIL_TARGET
port = 22
timeout = 120

[benches.rpi5.uboot]
# stop_string = "abc"        # normally auto-detected from the autoboot prompt
# too_late_patterns = ['\[MYBOOT\]']   # bootcmd output proving autoboot already ran
# ab = "rauc"                # enables `hil uboot slot` / `reset-counters`
# env_vars = ["bootcount", "rauc_slot"]   # extra vars `hil uboot` reads

[benches.rpi5.boot]
timeout = 180
# The built-in stages are generic Linux ones (optional "Booting Linux", then
# login:) and the only built-in fail pattern is "Kernel panic". A bench whose
# boot chain prints more replaces both lists. Stages must appear in order;
# optional ones may be silent and are skipped. Example for an RPi5 with
# U-Boot and a signed FIT:
#
# fail_patterns = [
#   'Kernel panic',
#   'Bad Data Hash',
#   'Bad hash value',
#   # Not "Verification failed": a FIT with several trust roots prints it for
#   # every key that does not match before one verifies ("+ OK").
#   "Failed to verify (required signature|'any' of the required signature)",
#   'Synchronous Abort',
#   'resetting \.\.\.',
# ]
#
# [[benches.rpi5.boot.stages]]
# name = "eeprom"
# pattern = 'BOOTLOADER|BOOTMODE:'
# optional = true
# [[benches.rpi5.boot.stages]]
# name = "uboot"
# pattern = 'U-Boot \d{4}\.\d{2}'
# [[benches.rpi5.boot.stages]]
# name = "fit-verified"
# pattern = 'Verifying Hash Integrity.*\+ OK'
# [[benches.rpi5.boot.stages]]
# name = "login"
# pattern = '^(?!Last )\S+ login: '   # console messages can follow on the same line
